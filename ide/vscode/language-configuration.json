{
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*// #region",
      "end": "^\\s*// #endregion"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$|^.*\\[[^\\]\"']*$",
    "decreaseIndentPattern": "^\\s*[}\\]],?(\\s*#.*)?$"
  },
  "wordPattern": "(\"([^\\\\\"\\s]|\\\\.)*\")|([A-Za-z0-9_$.\\-]+)"
}
