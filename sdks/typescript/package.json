{
  "name": "reconpro-sdk",
  "version": "1.0.0",
  "description": "Typed, zero-dependency TypeScript SDK around the ReconPro security CLI (subprocess + JSON contract)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "test:dist": "node tests/dist-smoke.mjs",
    "example:basic": "bun run examples/basic.ts",
    "example:errors": "bun run examples/error-handling.ts"
  },
  "keywords": [
    "security",
    "recon",
    "scanner",
    "cli",
    "sdk",
    "typescript",
    "reconpro"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/falconxa0-commits/reconpro",
    "directory": "sdks/typescript"
  }
}
